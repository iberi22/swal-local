{
  "name": "@iberi22/swal-local",
  "version": "0.1.0",
  "description": "Lógica local-first reutilizable del ecosistema SWAL: IndexedDB transaccional, auth PBKDF2, TTS/STT Web Speech, Ollama client. TS puro, zero-dependency runtime.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./store": {
      "types": "./dist/store/index.d.ts",
      "import": "./dist/store/index.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js"
    },
    "./tts": {
      "types": "./dist/tts/index.d.ts",
      "import": "./dist/tts/index.js"
    },
    "./stt": {
      "types": "./dist/stt/index.d.ts",
      "import": "./dist/stt/index.js"
    },
    "./ollama": {
      "types": "./dist/ollama/index.d.ts",
      "import": "./dist/ollama/index.js"
    },
    "./capabilities": {
      "types": "./dist/capabilities.d.ts",
      "import": "./dist/capabilities.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src/",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "30.0.1",
    "typescript": "^7.0.2",
    "vitest": "^3.2.6"
  },
  "keywords": [
    "local-first",
    "indexeddb",
    "pbkdf2",
    "web-speech",
    "ollama",
    "pwa",
    "swal"
  ],
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iberi22/swal-local.git"
  },
  "homepage": "https://github.com/iberi22/swal-local#readme",
  "bugs": {
    "url": "https://github.com/iberi22/swal-local/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
